# =============== Ignore Unity generated files/folders ===============
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should be tracked
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / IDE files
.vs/
.vscode/
.idea/

# Autogenerated by Unity
sysinfo.txt
*.tmpro
*.pidb
*.booproj
*.svd

# OS generated files
.DS_Store
Thumbs.db

# User-specific files
UserSettings/

# Build results
*.apk
*.aab
*.exe
*.app
*.xcodeproj
*.xcworkspace

# Packed packages
*.unitypackage