# Unity .gitignore — full recommended template

# =============== Ignore Unity generated files/folders ===============
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Crash dumps and system info
sysinfo.txt
*.stackdump

# =============== Keep asset metadata (track .meta files) ===============
# Track all .meta files so Unity asset metadata is preserved
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.json

# =============== User-specific / IDE files ===============
# Visual Studio / Rider / IDE
.vs/
.vscode/
.idea/

# Visual Studio generated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# JetBrains Rider caches
.idea/
*.sln.iml

# Mono / Rider caches
*.mono/

# =============== OS generated files ===============
.DS_Store
Thumbs.db
desktop.ini

# =============== Build files / packages / archives ===============
# Unity build outputs
*.apk
*.aab
*.exe
*.app
*.xcodeproj
*.xcworkspace

# Unity packages and exports (usually not tracked)
*.unitypackage

# Packed packages / caches
# (optional) Cache from Package Manager, keep manifests only
/Library/PackageCache/
# But keep Packages/manifest.json and Packages/*/package.json (handled above with !Packages)

# =============== Asset store / generated asset files ===============
# Asset store tools
Assets/AssetStoreTools*

# Temporary or generated files created by Unity or plugins
sysinfo.txt
*.tmpro

# =============== User and local settings ===============
UserSettings/
.vagrant/
*.local

# =============== Large binaries (recommended to use Git LFS instead) ===============
# Add extensions you want to avoid committing into normal Git — prefer LFS:
# Example:
# *.psd
# *.png
# *.jpg
# *.tga
# *.fbx
# *.obj
# *.blend
# *.wav
# *.mp3
# *.ogg
# *.mp4
# *.mov
# *.unitypackage

# If you want to ignore them completely (not recommended for important assets), uncomment:
# *.psd
# *.png
# *.jpg
# *.fbx
# *.wav
# *.mp4

# =============== Node / tooling (if present) ===============
node_modules/
npm-debug.log
yarn-error.log
.yarn/

# =============== Misc / backups / editor temp files ===============
*.log
*.swp
*~.nib
*.bak
*.old
*.orig

# =============== End of file ===============